{
  "compilerOptions": {
    // 1. Descomentado para organizar a entrada e saída
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "nodenext",
    "target": "esnext",

    // 2. Descomentado para o Node.js reconhecer globais (como process.env e crypto)
    "lib": ["esnext"],
    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  // 3. Adicionado para garantir que ele só compile a pasta src
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}